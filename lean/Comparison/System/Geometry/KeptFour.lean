theorem char_injective : ∀ d d' : Fin 16, (∀ t : Fin 5, pauliSignT t d = pauliSignT t d') → d = d' := by
  decide +kernel

theorem third4_char : ∀ (a b c : Fin 16) (t : Fin 5),
    pauliSignT t (third4T a b c) = pauliSignT t a * pauliSignT t b * pauliSignT t c := by
  decide +kernel

/-- The string `(a, b, c, d)` has trivial character under the five directions. -/
def CharTriv4 (a b c d : Fin 16) : Prop :=
  ∀ t : Fin 5, pauliSignT t a * pauliSignT t b * pauliSignT t c * pauliSignT t d = 1

instance (a b c d : Fin 16) : Decidable (CharTriv4 a b c d) := by
  unfold CharTriv4; infer_instance

theorem pm_one_cases {x y z w : ℤ} (hx : x = 1 ∨ x = -1) (hy : y = 1 ∨ y = -1)
    (hz : z = 1 ∨ z = -1) (hw : w = 1 ∨ w = -1) :
    (x * y * z * w = 1 ∨ x * y * z * w = -1) ∧ (x * y * z * w = 1 → w = x * y * z) := by
  rcases hx with rfl | rfl <;> rcases hy with rfl | rfl <;> rcases hz with rfl | rfl <;>
    rcases hw with rfl | rfl <;> norm_num

theorem cert4_unique (a b c d : Fin 16) (h : CharTriv4 a b c d) : d = third4T a b c := by
  apply char_injective
  intro t
  rw [third4_char]
  exact (pm_one_cases (pauliSignT_cases t a) (pauliSignT_cases t b) (pauliSignT_cases t c)
    (pauliSignT_cases t d)).2 (h t)

/-- The string `(a, b, c, d(a, b, c))`. -/
def str4 (a b c : Fin 16) : Fin 4 → Fin 16 := ![a, b, c, third4T a b c]

/-- The root string of the orbit `r`. -/
def repStr4 (r : Fin 99) : Fin 4 → Fin 16 := str4 (rep4A r) (rep4B r) (rep4C r)

theorem cert4_step : ∀ a b c : Fin 16, dep4T a b c = 0 ∨
    (dep4T (cliffPermT (gen4T a b c) a) (cliffPermT (gen4T a b c) b) (cliffPermT (gen4T a b c) c) <
        dep4T a b c ∧
      cliffPermT (gen4T a b c) (third4T a b c) =
        third4T (cliffPermT (gen4T a b c) a) (cliffPermT (gen4T a b c) b)
          (cliffPermT (gen4T a b c) c) ∧
      root4T (cliffPermT (gen4T a b c) a) (cliffPermT (gen4T a b c) b)
          (cliffPermT (gen4T a b c) c) = root4T a b c ∧
      sgn4T a b c = cliffSignT (gen4T a b c) a * cliffSignT (gen4T a b c) b *
        cliffSignT (gen4T a b c) c * cliffSignT (gen4T a b c) (third4T a b c) *
          sgn4T (cliffPermT (gen4T a b c) a) (cliffPermT (gen4T a b c) b)
            (cliffPermT (gen4T a b c) c)) := by
  decide +kernel

theorem cert4_rep : ∀ a b c : Fin 16, dep4T a b c = 0 →
    rep4A (root4T a b c) = a ∧ rep4B (root4T a b c) = b ∧ rep4C (root4T a b c) = c ∧
      sgn4T a b c = 1 := by
  decide +kernel

/-- **The coefficients of a kept operator on four systems along the trivial-character strings are
`±` those of the 99 roots.** -/
theorem coef4_root (X : Op 4) (hX : KeptN 4 X) (a b c : Fin 16) :
    coef (str4 a b c) X = ((sgn4T a b c : ℤ) : ℂ) * coef (repStr4 (root4T a b c)) X := by
  have key : ∀ n, ∀ a b c : Fin 16, dep4T a b c = n →
      coef (str4 a b c) X = ((sgn4T a b c : ℤ) : ℂ) * coef (repStr4 (root4T a b c)) X := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro a b c hn
      rcases cert4_step a b c with h0 | ⟨hlt, hthird, hroot, hsgn⟩
      · obtain ⟨ha, hb, hc, hs⟩ := cert4_rep a b c h0
        rw [hs, repStr4, ha, hb, hc]
        simp
      · have e := coef_eq_of_cliff X hX (str4 a b c) (gen4T a b c)
        have hcomp : cliffPermT (gen4T a b c) ∘ str4 a b c =
            str4 (cliffPermT (gen4T a b c) a) (cliffPermT (gen4T a b c) b)
              (cliffPermT (gen4T a b c) c) := by
          funext i
          fin_cases i
          · rfl
          · rfl
          · rfl
          · exact hthird
        have hz : coef (str4 (cliffPermT (gen4T a b c) a) (cliffPermT (gen4T a b c) b)
            (cliffPermT (gen4T a b c) c)) X =
            ((sgn4T (cliffPermT (gen4T a b c) a) (cliffPermT (gen4T a b c) b)
              (cliffPermT (gen4T a b c) c) : ℤ) : ℂ) *
              coef (repStr4 (root4T (cliffPermT (gen4T a b c) a) (cliffPermT (gen4T a b c) b)
                (cliffPermT (gen4T a b c) c))) X :=
          ih _ (by omega) _ _ _ rfl
        rw [hcomp, hz, hroot] at e
        have e0 : str4 a b c 0 = a := rfl
        have e1 : str4 a b c 1 = b := rfl
        have e2 : str4 a b c 2 = c := rfl
        have e3 : str4 a b c 3 = third4T a b c := rfl
        rw [e, Fin.prod_univ_four, hsgn, e0, e1, e2, e3]
        push_cast
        ring
  exact key _ a b c rfl

/-- **Every coefficient of a kept operator on four systems is `±` a root coefficient or zero.** -/
theorem coef4_eq (X : Op 4) (hX : KeptN 4 X) (σ : Fin 4 → Fin 16) :
    coef σ X = if CharTriv4 (σ 0) (σ 1) (σ 2) (σ 3) then
      ((sgn4T (σ 0) (σ 1) (σ 2) : ℤ) : ℂ) * coef (repStr4 (root4T (σ 0) (σ 1) (σ 2))) X else 0 := by
  split_ifs with hσ
  · have hs : σ = str4 (σ 0) (σ 1) (σ 2) := by
      funext i
      fin_cases i
      · rfl
      · rfl
      · rfl
      · exact cert4_unique _ _ _ _ hσ
    calc coef σ X = coef (str4 (σ 0) (σ 1) (σ 2)) X := by rw [← hs]
      _ = _ := coef4_root X hX _ _ _
  · simp only [CharTriv4, not_forall] at hσ
    obtain ⟨t, ht⟩ := hσ
    have hm := ((pm_one_cases (pauliSignT_cases t (σ 0)) (pauliSignT_cases t (σ 1))
      (pauliSignT_cases t (σ 2)) (pauliSignT_cases t (σ 3))).1).resolve_left ht
    apply coef_zero_of_char X hX σ t
    rw [Fin.prod_univ_four]
    exact_mod_cast hm

/-! ## The rotation `γ₀γ₁` on one of the systems -/

/-- `F = γ₀γ₁` on the system `i`, the identity on the others. -/
noncomputable def Fat {N : ℕ} (i : Fin N) : Op N :=
  kronN (Function.update (fun _ => (1 : Matrix Four Four ℂ)) i (γ 0 * γ 1))

theorem kronN_update_apply {N : ℕ} (A : Fin N → Matrix Four Four ℂ) (i : Fin N)
    (B : Matrix Four Four ℂ) (w v : Fin N → Four) :
    kronN (Function.update A i B) w v = B (w i) (v i) * ∏ j ∈ Finset.univ.erase i, A j (w j) (v j) := by
  rw [kronN_apply, ← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ i), Function.update_self]
  congr 1
  refine Finset.prod_congr rfl fun j hj => ?_
  rw [Function.update_of_ne (Finset.ne_of_mem_erase hj)]

theorem commFZ : ∀ k : Fin 16,
    γZ 0 * γZ 1 * obsZ k - obsZ k * (γZ 0 * γZ 1) = ((muT k : ℤ) : GaussianInt) • obsZ (kapT k) := by
  decide +kernel

theorem commF_obs (k : Fin 16) :
    γ 0 * γ 1 * obs k - obs k * (γ 0 * γ 1) = ((muT k : ℤ) : ℂ) • obs (kapT k) := by
  have h := congrArg (RingHom.mapMatrix GaussianInt.toComplex) (commFZ k)
  simp only [map_mul, map_sub, RingHom.mapMatrix_apply, γZ_map, obsZ_map, GroupsContinuumLaw.map_smulZ,
    map_intCast] at h
  exact h

theorem obs_update {N : ℕ} (ρ : Fin N → Fin 16) (i : Fin N) (k : Fin 16) :
    (fun j => obs (Function.update ρ i k j)) = Function.update (fun j => obs (ρ j)) i (obs k) := by
  funext j
  by_cases hj : j = i
  · subst hj; simp
  · simp [Function.update_of_ne hj]

/-- **`[F_i, P_ρ] = μ(ρ_i) P_{ρ[i ↦ κ(ρ_i)]}`.** -/
theorem Fat_pstr_comm {N : ℕ} (i : Fin N) (ρ : Fin N → Fin 16) :
    Fat i * pstr ρ - pstr ρ * Fat i =
      ((muT (ρ i) : ℤ) : ℂ) • pstr (Function.update ρ i (kapT (ρ i))) := by
  have h1 : (fun j => Function.update (fun _ => (1 : Matrix Four Four ℂ)) i (γ 0 * γ 1) j * obs (ρ j)) =
      Function.update (fun j => obs (ρ j)) i (γ 0 * γ 1 * obs (ρ i)) := by
    funext j
    by_cases hj : j = i
    · subst hj; simp
    · simp [Function.update_of_ne hj]
  have h2 : (fun j => obs (ρ j) * Function.update (fun _ => (1 : Matrix Four Four ℂ)) i (γ 0 * γ 1) j) =
      Function.update (fun j => obs (ρ j)) i (obs (ρ i) * (γ 0 * γ 1)) := by
    funext j
    by_cases hj : j = i
    · subst hj; simp
    · simp [Function.update_of_ne hj]
  ext w v
  rw [Matrix.sub_apply, Fat, pstr, kronN_mul, kronN_mul, h1, h2, Matrix.smul_apply, pstr,
    obs_update, kronN_update_apply, kronN_update_apply, kronN_update_apply, ← sub_mul, smul_eq_mul,
    ← mul_assoc ((muT (ρ i) : ℤ) : ℂ)]
  congr 1
  rw [← Matrix.sub_apply, commF_obs, Matrix.smul_apply, smul_eq_mul]

/-- **What `[X, Σ_i F_i] = 0` says about the coefficients:** for every string `ρ`,
`Σ_i μ(ρ_i) c_{ρ[i ↦ κ(ρ_i)]}(X) = 0`. -/
theorem D_relation {N : ℕ} (X : Op N) (hD : X * (∑ i, Fat i) = (∑ i, Fat i) * X)
    (ρ : Fin N → Fin 16) :
    ∑ i, ((muT (ρ i) : ℤ) : ℂ) * coef (Function.update ρ i (kapT (ρ i))) X = 0 := by
  have h0 : (((∑ i, Fat i) * pstr ρ - pstr ρ * (∑ i, Fat i)) * X).trace = 0 := by
    have e : ((∑ i, Fat i) * pstr ρ * X).trace = (pstr ρ * (∑ i, Fat i) * X).trace := by
      rw [Matrix.mul_assoc, Matrix.trace_mul_comm, Matrix.mul_assoc, hD, ← Matrix.mul_assoc]
    rw [Matrix.sub_mul, Matrix.trace_sub, e, sub_self]
  rw [Finset.sum_mul, Finset.mul_sum, ← Finset.sum_sub_distrib, Finset.sum_mul,
    Matrix.trace_sum] at h0
  simp only [Fat_pstr_comm, Matrix.smul_mul, Matrix.trace_smul, smul_eq_mul] at h0
  have h4 : (4 : ℂ) ^ N ≠ 0 := pow_ne_zero _ (by norm_num)
  have : ∑ i, ((muT (ρ i) : ℤ) : ℂ) * coef (Function.update ρ i (kapT (ρ i))) X =
      (∑ i, ((muT (ρ i) : ℤ) : ℂ) * (pstr (Function.update ρ i (kapT (ρ i))) * X).trace) / 4 ^ N := by
    rw [Finset.sum_div]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [coef, mul_div_assoc]
  rw [this, h0, zero_div]

/-! ## A kept operator on four systems commutes with `Σ_i F_i` -/

theorem F_sq : (γ 0 * γ 1) * (γ 0 * γ 1) = -1 := Article.γγ_sq (by decide)

theorem F_conjTranspose : (γ 0 * γ 1)ᴴ = -(γ 0 * γ 1) := Article.γγ_conjTranspose (by decide)

theorem F_join : (γ 0 * γ 1) * J + J * (γ 0 * γ 1)ᵀ = 0 := by
  rw [Article.J_γγ_transpose, γ_anticomm (show (1 : Fin 5) ≠ 0 by decide), Matrix.neg_mul,
    add_neg_cancel]

/-- The rotation `U_t = (1 + tF)/√(1 + t²)`, `F = γ₀γ₁`, for real `t`. -/
noncomputable def Ut (t : ℝ) : Matrix Four Four ℂ :=
  ((√(1 + t ^ 2) : ℝ) : ℂ)⁻¹ • (1 + (t : ℂ) • (γ 0 * γ 1))

theorem one_add_sq_pos (t : ℝ) : 0 < 1 + t ^ 2 := by positivity

theorem sqrt_ne (t : ℝ) : ((√(1 + t ^ 2) : ℝ) : ℂ) ≠ 0 := by
  have : 0 < √(1 + t ^ 2) := Real.sqrt_pos.mpr (one_add_sq_pos t)
  exact_mod_cast this.ne'

theorem inv_sqrt_sq (t : ℝ) : (((√(1 + t ^ 2) : ℝ) : ℂ)⁻¹) ^ 2 = ((1 + t ^ 2 : ℝ) : ℂ)⁻¹ := by
  rw [inv_pow, ← Complex.ofReal_pow, Real.sq_sqrt (one_add_sq_pos t).le]

theorem one_add_sq_ne (t : ℝ) : ((1 + t ^ 2 : ℝ) : ℂ) ≠ 0 := by
  exact_mod_cast (one_add_sq_pos t).ne'

theorem Ut_unitary (t : ℝ) : Ut t * (Ut t)ᴴ = 1 := by
  have hs : star (((√(1 + t ^ 2) : ℝ) : ℂ)⁻¹) = ((√(1 + t ^ 2) : ℝ) : ℂ)⁻¹ := by simp
  have ht : star (t : ℂ) = t := Complex.conj_ofReal t
  have e : (1 + (t : ℂ) • (γ 0 * γ 1)) * (1 + (t : ℂ) • -(γ 0 * γ 1)) =
      ((1 + t ^ 2 : ℝ) : ℂ) • (1 : Matrix Four Four ℂ) := by
    have h2 : (γ 0 * γ 1) * (γ 0 * γ 1) = -1 := F_sq
    calc (1 + (t : ℂ) • (γ 0 * γ 1)) * (1 + (t : ℂ) • -(γ 0 * γ 1)) =
        1 - ((t : ℂ) * t) • ((γ 0 * γ 1) * (γ 0 * γ 1)) := by
          simp only [Matrix.add_mul, Matrix.mul_add, Matrix.one_mul, Matrix.mul_one,
            Matrix.smul_mul, Matrix.mul_smul, smul_smul, Matrix.mul_neg, smul_neg]
          module
      _ = ((1 + t ^ 2 : ℝ) : ℂ) • (1 : Matrix Four Four ℂ) := by
          rw [h2]
          push_cast
          module
  rw [Ut, Matrix.conjTranspose_smul, hs, Matrix.conjTranspose_add, Matrix.conjTranspose_one,
    Matrix.conjTranspose_smul, ht, F_conjTranspose, Matrix.smul_mul, Matrix.mul_smul, smul_smul,
    ← sq, inv_sqrt_sq, e, smul_smul, inv_mul_cancel₀ (one_add_sq_ne t), one_smul]

theorem Ut_keeps_J (t : ℝ) : Ut t * J * (Ut t)ᵀ = J := by
  have hk : (γ 0 * γ 1) * J * (γ 0 * γ 1)ᵀ = J := Article.γγ_keeps_J
  have e : (1 + (t : ℂ) • (γ 0 * γ 1)) * J * (1 + (t : ℂ) • (γ 0 * γ 1)ᵀ) =
      ((1 + t ^ 2 : ℝ) : ℂ) • J := by
    calc (1 + (t : ℂ) • (γ 0 * γ 1)) * J * (1 + (t : ℂ) • (γ 0 * γ 1)ᵀ) =
        J + (t : ℂ) • ((γ 0 * γ 1) * J + J * (γ 0 * γ 1)ᵀ) +
          ((t : ℂ) * t) • ((γ 0 * γ 1) * J * (γ 0 * γ 1)ᵀ) := by
          simp only [Matrix.add_mul, Matrix.mul_add, Matrix.one_mul, Matrix.mul_one,
            Matrix.smul_mul, Matrix.mul_smul, smul_add, smul_smul]
          module
      _ = ((1 + t ^ 2 : ℝ) : ℂ) • J := by
          rw [F_join, hk, smul_zero, add_zero]
          push_cast
          module
  rw [Ut, Matrix.transpose_smul, Matrix.transpose_add, Matrix.transpose_one,
    Matrix.transpose_smul, Matrix.smul_mul, Matrix.smul_mul, Matrix.mul_smul, smul_smul, ← sq,
    inv_sqrt_sq, e, smul_smul, inv_mul_cancel₀ (one_add_sq_ne t), one_smul]

/-- `K_A`: `F` on the systems of `A`, the identity on the others. -/
noncomputable def KA {N : ℕ} (A : Finset (Fin N)) : Op N :=
  kronN fun j => if j ∈ A then γ 0 * γ 1 else 1

theorem tpow_one_add {N : ℕ} (t : ℂ) :
    tpow N (1 + t • (γ 0 * γ 1)) = ∑ A : Finset (Fin N), t ^ A.card • KA A := by
  ext w v
  rw [tpow, kronN_apply, Matrix.sum_apply]
  have hsplit : ∀ j, (1 + t • (γ 0 * γ 1)) (w j) (v j) =
      t * (γ 0 * γ 1) (w j) (v j) + (1 : Matrix Four Four ℂ) (w j) (v j) := by
    intro j
    rw [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul, add_comm]
  simp only [hsplit]
  rw [Finset.prod_add, Finset.powerset_univ]
  refine Finset.sum_congr rfl fun A _ => ?_
  rw [Matrix.smul_apply, smul_eq_mul, KA, kronN_apply, Finset.prod_mul_distrib, Finset.prod_const,
    mul_assoc, ← Finset.prod_mul_prod_compl A]
  congr 2
  · exact Finset.prod_congr rfl fun j hj => by rw [if_pos hj]
  · rw [Finset.compl_eq_univ_sdiff]
    exact Finset.prod_congr rfl fun j hj => by rw [if_neg (Finset.mem_sdiff.mp hj).2]

theorem tpow_Ut (t : ℝ) :
    tpow 4 (Ut t) = (((√(1 + t ^ 2) : ℝ) : ℂ)⁻¹) ^ 4 •
      ∑ A : Finset (Fin 4), ((t : ℂ) ^ A.card) • KA A := by
  rw [← tpow_one_add, tpow, tpow, Ut]
  have := kronN_smul (fun _ : Fin 4 => ((√(1 + t ^ 2) : ℝ) : ℂ)⁻¹)
    (fun _ : Fin 4 => (1 + (t : ℂ) • (γ 0 * γ 1)))
  rw [this, Finset.prod_const, Finset.card_univ, Fintype.card_fin]

theorem KA_singleton {N : ℕ} (i : Fin N) : KA {i} = Fat i := by
  unfold KA Fat
  congr 1
  funext j
  by_cases h : j = i
  · subst h; simp
  · simp [h, Function.update_of_ne h]

/-- **A kept operator on four systems commutes with `Σ_i F_i`**: the rotations `U_t` give a polynomial in
`t` that vanishes at every real `t`, and its coefficient of `t` is the commutator with `Σ_i F_i`. -/
theorem kept4_comm_D (X : Op 4) (hX : KeptN 4 X) : X * (∑ i, Fat i) = (∑ i, Fat i) * X := by
  have hcomm : ∀ t : ℝ, X * (∑ A : Finset (Fin 4), ((t : ℂ) ^ A.card) • KA A) =
      (∑ A : Finset (Fin 4), ((t : ℂ) ^ A.card) • KA A) * X := by
    intro t
    have h := hX (Ut t) (Ut_unitary t) (Ut_keeps_J t)
    rw [tpow_Ut, Matrix.mul_smul, Matrix.smul_mul] at h
    exact smul_right_injective _ (pow_ne_zero _ (inv_ne_zero (sqrt_ne t))) h
  ext w v
  set c : Finset (Fin 4) → ℂ := fun A => (X * KA A - KA A * X) w v with hc
  have hpoly : ∀ t : ℝ, ∑ A : Finset (Fin 4), c A * (t : ℂ) ^ A.card = 0 := by
    intro t
    have e := congrFun (congrFun (hcomm t) w) v
    rw [← sub_eq_zero] at e
    rw [← e, Matrix.mul_sum, Matrix.sum_mul, Matrix.sum_apply, Matrix.sum_apply,
      ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun A _ => ?_
    simp only [hc, Matrix.mul_smul, Matrix.smul_mul, Matrix.smul_apply, smul_eq_mul,
      Matrix.sub_apply]
    ring
  set p : Polynomial ℂ := ∑ A : Finset (Fin 4), Polynomial.C (c A) * Polynomial.X ^ A.card with hp
  have hp0 : p = 0 := by
    apply Polynomial.eq_zero_of_infinite_isRoot
    apply Set.infinite_of_injective_forall_mem (f := fun t : ℝ => (t : ℂ)) Complex.ofReal_injective
    intro t
    simp only [Set.mem_setOf_eq, Polynomial.IsRoot.def, hp, Polynomial.eval_finset_sum,
      Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
    exact hpoly t
  have h1 := congrArg (fun q => Polynomial.coeff q 1) hp0
  simp only [hp, Polynomial.finset_sum_coeff, Polynomial.coeff_C_mul_X_pow,
    Polynomial.coeff_zero] at h1
  have hs : (∑ A : Finset (Fin 4), if 1 = A.card then c A else 0) = ∑ i : Fin 4, c {i} := by
    rw [← Finset.sum_filter]
    have hf : (Finset.univ.filter fun A : Finset (Fin 4) => 1 = A.card) =
        Finset.univ.map ⟨fun i => ({i} : Finset (Fin 4)), Finset.singleton_injective⟩ := by
      ext A
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_map,
        Function.Embedding.coeFn_mk]
      constructor
      · intro h
        obtain ⟨i, hi⟩ := Finset.card_eq_one.mp h.symm
        exact ⟨i, hi.symm⟩
      · rintro ⟨i, rfl⟩
        simp
    rw [hf, Finset.sum_map]
    rfl
  rw [hs] at h1
  have h2 : ((X * ∑ i, Fat i - (∑ i, Fat i) * X : Op 4)) w v = ∑ i : Fin 4, c {i} := by
    rw [Matrix.mul_sum, Matrix.sum_mul, ← Finset.sum_sub_distrib, Matrix.sum_apply]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp only [hc, KA_singleton]
  have h3 := h2.trans h1
  rw [Matrix.sub_apply] at h3
  exact sub_eq_zero.mp h3

/-! ## Four systems: at most 84 -/

/-- The root coefficients of a kept operator. -/
noncomputable def rootCoef (X : Op 4) (r : Fin 99) : ℂ := coef (repStr4 r) X

/-- The coefficient of a string through the roots: `sgn(σ)c_{root σ}` or `0`. -/
def viaRoot (σ : Fin 4 → Fin 16) (r : Fin 99) : ℤ :=
  if CharTriv4 (σ 0) (σ 1) (σ 2) (σ 3) ∧ root4T (σ 0) (σ 1) (σ 2) = r then sgn4T (σ 0) (σ 1) (σ 2)
  else 0

theorem coef4_viaRoot (X : Op 4) (hX : KeptN 4 X) (σ : Fin 4 → Fin 16) :
    coef σ X = ∑ r, ((viaRoot σ r : ℤ) : ℂ) * rootCoef X r := by
  rw [coef4_eq X hX σ]
  split_ifs with hσ
  · rw [Finset.sum_eq_single (root4T (σ 0) (σ 1) (σ 2))]
    · simp [viaRoot, hσ, rootCoef]
    · intro r _ hr
      simp [viaRoot, hσ, Ne.symm hr]
    · simp
  · symm
    refine Finset.sum_eq_zero fun r _ => ?_
    simp [viaRoot, hσ]

/-- The fifteen `D`-equations, as integer rows on the 99 roots. -/
def dRowOf (j : Fin 15) (r : Fin 99) : ℤ :=
  ∑ i : Fin 4, muT (dRho j i) * viaRoot (Function.update (dRho j) i (kapT (dRho j i))) r

theorem dRow_eq : ∀ (j : Fin 15) (r : Fin 99), dRowOf j r = dRow j r := by
  decide +kernel

theorem dRow_piv_upper : ∀ j k : Fin 15, k ≤ j ∨ dRow k (dPiv j) = 0 := by
  decide +kernel

theorem dRow_piv_diag : ∀ k : Fin 15, dRow k (dPiv k) ≠ 0 := by
  decide +kernel

theorem free_or_piv : ∀ r : Fin 99, (∃ m : Fin 84, freeRoot m = r) ∨ (∃ k : Fin 15, dPiv k = r) := by
  decide +kernel

theorem dPiv_injective : Function.Injective dPiv := by
  intro a b h
  revert a b
  decide +kernel

theorem dPiv_ne_free : ∀ (k : Fin 15) (m : Fin 84), dPiv k ≠ freeRoot m := by
  decide +kernel

/-- **The fifteen equations on the root coefficients of a kept operator.** -/
theorem kept4_rows (X : Op 4) (hX : KeptN 4 X) (j : Fin 15) :
    ∑ r, ((dRow j r : ℤ) : ℂ) * rootCoef X r = 0 := by
  have h := D_relation X (kept4_comm_D X hX) (dRho j)
  simp only [coef4_viaRoot X hX, Finset.mul_sum] at h
  rw [Finset.sum_comm] at h
  rw [← h]
  refine Finset.sum_congr rfl fun r _ => ?_
  rw [← dRow_eq, dRowOf, Int.cast_sum, Finset.sum_mul]
  refine Finset.sum_congr rfl fun i _ => ?_
  push_cast
  ring

/-- **The 84 free root coefficients fix a kept operator on four systems.** -/
theorem coef4_zero (X : Op 4) (hX : KeptN 4 X) (h : ∀ m : Fin 84, rootCoef X (freeRoot m) = 0) :
    ∀ σ, coef σ X = 0 := by
  set Mp : Matrix (Fin 15) (Fin 15) ℤ := Matrix.of fun k j => dRow k (dPiv j) with hMp
  have hup : Mp.IsUpperTriangular := fun k j hjk => by
    simp only [hMp, Matrix.of_apply]
    exact (dRow_piv_upper j k).resolve_left (not_le.mpr hjk)
  have hdet : Mp.det ≠ 0 := by
    rw [Matrix.det_of_isUpperTriangular hup]
    exact Finset.prod_ne_zero_iff.mpr fun k _ => by simpa [hMp] using dRow_piv_diag k
  have hsum : ∀ k : Fin 15, ∑ r, ((dRow k r : ℤ) : ℂ) * rootCoef X r =
      ∑ j, ((dRow k (dPiv j) : ℤ) : ℂ) * rootCoef X (dPiv j) := by
    intro k
    rw [← Finset.sum_image (f := fun r => ((dRow k r : ℤ) : ℂ) * rootCoef X r)
      (fun a _ b _ hab => dPiv_injective hab)]
    symm
    apply Finset.sum_subset (Finset.subset_univ _)
    intro r _ hr
    rcases free_or_piv r with ⟨m, rfl⟩ | ⟨j, rfl⟩
    · rw [h m, mul_zero]
    · exact absurd (Finset.mem_image_of_mem _ (Finset.mem_univ j)) hr
  have hv : (Mp.map (Int.cast : ℤ → ℂ)) *ᵥ (fun j => rootCoef X (dPiv j)) = 0 := by
    funext k
    have e := kept4_rows X hX k
    rw [hsum k] at e
    simp only [Matrix.mulVec, dotProduct, Matrix.map_apply, hMp, Matrix.of_apply, Pi.zero_apply]
    exact e
  have hdet' : (Mp.map (Int.cast : ℤ → ℂ)).det ≠ 0 := by
    have h' := RingHom.map_det (Int.castRingHom ℂ) Mp
    rw [RingHom.mapMatrix_apply, Int.coe_castRingHom] at h'
    rw [← h']
    exact Int.cast_ne_zero.mpr hdet
  have hpiv : ∀ k : Fin 15, rootCoef X (dPiv k) = 0 :=
    fun k => congrFun (Matrix.eq_zero_of_mulVec_eq_zero hdet' hv) k
  have hall : ∀ r, rootCoef X r = 0 := by
    intro r
    rcases free_or_piv r with ⟨m, rfl⟩ | ⟨k, rfl⟩
    · exact h m
    · exact hpiv k
  intro σ
  rw [coef4_viaRoot X hX σ]
  exact Finset.sum_eq_zero fun r _ => by rw [hall r, mul_zero]

theorem finrank_kept4_le : finrank ℂ (keptN 4) ≤ 84 := by
  let φ : keptN 4 →ₗ[ℂ] (Fin 84 → ℂ) :=
    (LinearMap.pi fun m => coefL (repStr4 (freeRoot m))).comp (keptN 4).subtype
  have hinj : Function.Injective φ := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro X hX
    have hz : ∀ m, rootCoef X.1 (freeRoot m) = 0 := fun m => congrFun hX m
    exact Subtype.ext (eq_zero_of_coef X.1 (coef4_zero X.1 X.2 hz))
  have := LinearMap.finrank_le_finrank_of_injective hinj
  simpa using this

/-! ## Four systems: at least 84 -/

/-- `E₀₁E₂₃` with integer entries. -/
def EEZ (w v : Fin 4 → Four) : ℤ :=
  Jint (w 0) (w 1) * Jint (v 0) (v 1) * Jint (w 2) (w 3) * Jint (v 2) (v 3)

theorem EE_apply (w v : Fin 4 → Four) :
    (Eab 0 1 * Eab 2 3 : Op 4) w v = ((EEZ w v : ℤ) : ℂ) := by
  have c1 : ∀ c : Fin 4, c ≠ 0 → c ≠ 1 → w c = (![v 0, v 1, w 2, w 3] : Fin 4 → Four) c := by
    intro c h0 h1
    fin_cases c
    · exact absurd rfl h0
    · exact absurd rfl h1
    · rfl
    · rfl
  have c2 : ∀ c : Fin 4, c ≠ 2 → c ≠ 3 → (![v 0, v 1, w 2, w 3] : Fin 4 → Four) c = v c := by
    intro c h2 h3
    fin_cases c
    · rfl
    · rfl
    · exact absurd rfl h2
    · exact absurd rfl h3
  rw [Matrix.mul_apply, Finset.sum_eq_single (![v 0, v 1, w 2, w 3] : Fin 4 → Four)]
  · rw [Eab_apply_eq, Eab_apply_eq, EabZ, EabZ, if_pos c1, if_pos c2]
    have e0 : (![v 0, v 1, w 2, w 3] : Fin 4 → Four) 0 = v 0 := rfl
    have e1 : (![v 0, v 1, w 2, w 3] : Fin 4 → Four) 1 = v 1 := rfl
    have e2 : (![v 0, v 1, w 2, w 3] : Fin 4 → Four) 2 = w 2 := rfl
    have e3 : (![v 0, v 1, w 2, w 3] : Fin 4 → Four) 3 = w 3 := rfl
    rw [e0, e1, e2, e3, EEZ]
    push_cast
    ring
  · intro u _ hu
    rw [Eab_apply_eq, Eab_apply_eq, EabZ, EabZ]
    by_cases h23 : u 2 = w 2 ∧ u 3 = w 3
    · have h01 : ¬ (∀ c : Fin 4, c ≠ 2 → c ≠ 3 → u c = v c) := by
        intro hc
        apply hu
        funext c
        fin_cases c
        · exact hc 0 (by decide) (by decide)
        · exact hc 1 (by decide) (by decide)
        · exact h23.1
        · exact h23.2
      rw [if_neg h01]
      simp
    · have h01 : ¬ (∀ c : Fin 4, c ≠ 0 → c ≠ 1 → w c = u c) := by
        intro hc
        exact h23 ⟨(hc 2 (by decide) (by decide)).symm, (hc 3 (by decide) (by decide)).symm⟩
      rw [if_neg h01]
      simp
  · simp

/-- **Eighty-four products of swaps and pairings on four systems.** -/
noncomputable def B4 (j : Fin 84) : Op 4 :=
  if diag4Kind j = 0 then permOp (perm4 (diag4L j))
  else if diag4Kind j = 1 then permOp (perm4 (diag4L j)) * Eab 0 1 * permOp (perm4 (diag4R j))
  else permOp (perm4 (diag4L j)) * (Eab 0 1 * Eab 2 3) * permOp (perm4 (diag4R j))

def B4Z (j : Fin 84) (w v : Fin 4 → Four) : ℤ :=
  if diag4Kind j = 0 then permZ (perm4 (diag4L j)) w v
  else if diag4Kind j = 1 then
    EabZ 0 1 (w ∘ perm4 (diag4L j)) (v ∘ (perm4 (diag4R j)).symm)
  else EEZ (w ∘ perm4 (diag4L j)) (v ∘ (perm4 (diag4R j)).symm)

theorem B4_apply (j : Fin 84) (w v : Fin 4 → Four) : B4 j w v = ((B4Z j w v : ℤ) : ℂ) := by
  unfold B4 B4Z
  split_ifs
  · exact permOp_apply_eq _ w v
  · rw [mul_permOp_apply, permOp_mul_apply, Eab_apply_eq]
  · rw [mul_permOp_apply, permOp_mul_apply, EE_apply]

def M4f (k j : Fin 84) : ℤ := B4Z j (pos4W k) (pos4V k)

def M4 : Matrix (Fin 84) (Fin 84) ℤ := Matrix.of M4f

theorem M4f_upper : ∀ k j : Fin 84, k ≤ j ∨ M4f k j = 0 := by
  decide +kernel

theorem M4f_diag : ∀ k : Fin 84, M4f k k ≠ 0 := by
  decide +kernel

theorem M4_upper (k j : Fin 84) (h : j < k) : M4 k j = 0 :=
  (M4f_upper k j).resolve_left (not_le.mpr h)

theorem M4_diag (k : Fin 84) : M4 k k ≠ 0 := M4f_diag k

theorem M4_det : M4.det ≠ 0 := by
  rw [Matrix.det_of_isUpperTriangular (fun k j hjk => M4_upper k j hjk)]
  exact Finset.prod_ne_zero_iff.mpr fun k _ => M4_diag k

theorem B4_linearIndependent : LinearIndependent ℂ B4 := by
  rw [Fintype.linearIndependent_iff]
  intro g hg
  have hM : (M4.map (Int.cast : ℤ → ℂ)) *ᵥ g = 0 := by
    funext k
    have e := congrFun (congrFun hg (pos4W k)) (pos4V k)
    simp only [Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul, Matrix.zero_apply, B4_apply] at e
    simp only [Matrix.mulVec, dotProduct, Matrix.map_apply, M4, M4f, Matrix.of_apply, Pi.zero_apply]
    rw [← e]
    exact Finset.sum_congr rfl fun j _ => mul_comm _ _
  have hdet : (M4.map (Int.cast : ℤ → ℂ)).det ≠ 0 := by
    have h := RingHom.map_det (Int.castRingHom ℂ) M4
    rw [RingHom.mapMatrix_apply, Int.coe_castRingHom] at h
    rw [← h]
    exact Int.cast_ne_zero.mpr M4_det
  exact congrFun (Matrix.eq_zero_of_mulVec_eq_zero hdet hM)

theorem B4_mem (j : Fin 84) : B4 j ∈ brauerAlg 4 := by
  unfold B4
  split_ifs
  · exact permOp_mem_brauer _
  · exact (brauerAlg 4).mul_mem ((brauerAlg 4).mul_mem (permOp_mem_brauer _)
      (Eab_mem_brauer (by decide))) (permOp_mem_brauer _)
  · exact (brauerAlg 4).mul_mem ((brauerAlg 4).mul_mem (permOp_mem_brauer _)
      ((brauerAlg 4).mul_mem (Eab_mem_brauer (by decide)) (Eab_mem_brauer (by decide))))
      (permOp_mem_brauer _)

theorem span_B4_le_brauer :
    Submodule.span ℂ (Set.range B4) ≤ Subalgebra.toSubmodule (brauerAlg 4) := by
  rw [Submodule.span_le]
  rintro _ ⟨j, rfl⟩
  exact B4_mem j

theorem keptN_four_eq : keptN 4 = Submodule.span ℂ (Set.range B4) := by
  have hle : Submodule.span ℂ (Set.range B4) ≤ keptN 4 :=
    span_B4_le_brauer.trans (brauer_le_kept 4)
  have hspan : finrank ℂ (Submodule.span ℂ (Set.range B4)) = 84 := by
    rw [finrank_span_eq_card B4_linearIndependent]
    simp
  symm
  apply Submodule.eq_of_le_of_finrank_le hle
  rw [hspan]
  exact finrank_kept4_le

theorem finrank_kept4 : finrank ℂ (keptN 4) = 84 := by
  rw [keptN_four_eq, finrank_span_eq_card B4_linearIndependent]
  simp

theorem kept4_iff (X : Op 4) : KeptN 4 X ↔ X ∈ brauerAlg 4 := by
  constructor
  · intro hX
    have h : X ∈ keptN 4 := hX
    rw [keptN_four_eq] at h
    exact span_B4_le_brauer h
  · intro hX
    exact brauer_kept 4 hX

end Geometry

open Comparison.System.Geometry

/-- **Proposition 15 on four systems.** The operators on four systems kept by every rotation of `Sp(2)`
are exactly the sums of products of swaps and pairings; they form a space of dimension 84, spanned by
84 products (permutations, `P_πE₀₁P_ρ`, `P_πE₀₁E₂₃P_ρ`), which are independent. Recognition: none. -/
theorem Geometry.kept_four_statement :
    (∀ X : Op 4, KeptN 4 X ↔ X ∈ brauerAlg 4) ∧ finrank ℂ (keptN 4) = 84 ∧
    keptN 4 = Submodule.span ℂ (Set.range B4) ∧ LinearIndependent ℂ B4 :=
  ⟨kept4_iff, finrank_kept4, keptN_four_eq, B4_linearIndependent⟩

end Comparison.System

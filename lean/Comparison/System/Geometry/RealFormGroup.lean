import Comparison.System.Geometry.RealForm
import Comparison.System.Geometry.DetExp

/-!
# The geometry of comparison: the real form of a division lies in its group

Definition 15's real form of a division,
`realForm P`, is the group generated by the `e^X` with `X` in `realFormAlg P`. For the division of the
lines `D` with the singlet undivided:

* `|D|` even: `realForm` lies in `formGroup h_D = {U : det U = 1, U†h_DU = h_D}`, which is `SU(4)` for
  `D = ∅` (`h_∅ = 1`) and the group of a form of signature `(2, 2)` for `|D| = 2, 4`
  (`realForm_le_formGroup`);
* `|D|` odd: `realForm` lies in `antiGroup (γ_DJ) = {U : det U = 1, UC_D = C_DU}`, `C_Dv = γ_DJv̄`,
  with `C_D² = −1` for `|D| = 1, 5` and `+1` for `|D| = 3` (`realForm_le_antiGroup`).

The proof: `det e^X = e^{tr X} = 1` (`det_exp`); for the form, `X† = −hXh` and `h e^{−X} h = e^{X†} =
(e^X)†`; for the antilinear map, `X = MX̄M⁻¹` and `e^X M = M e^{X̄}`, `e^{X̄} = conj(e^X)`.
-/

open scoped InnerProductSpace Kronecker ComplexOrder
open Matrix Complex Module

namespace Comparison.System

namespace Geometry

/-! ## The two types of group -/

/-- The rotations of determinant one that keep the form `h`: `U†hU = h`. -/
def formGroup (h : Matrix Four Four ℂ) : Subgroup (Matrix Four Four ℂ)ˣ where
  carrier := {U | (U : Matrix Four Four ℂ).det = 1 ∧ (U : Matrix Four Four ℂ)ᴴ * h * U = h}
  one_mem' := by simp
  mul_mem' := by
    rintro U V ⟨hU1, hU2⟩ ⟨hV1, hV2⟩
    refine ⟨by rw [Units.val_mul, Matrix.det_mul, hU1, hV1, one_mul], ?_⟩
    rw [Units.val_mul, Matrix.conjTranspose_mul]
    calc (V : Matrix Four Four ℂ)ᴴ * (U : Matrix Four Four ℂ)ᴴ * h *
          ((U : Matrix Four Four ℂ) * V) =
        (V : Matrix Four Four ℂ)ᴴ * ((U : Matrix Four Four ℂ)ᴴ * h * U) * V := by
          simp only [Matrix.mul_assoc]
      _ = h := by rw [hU2, hV2]
  inv_mem' := by
    rintro U ⟨hU1, hU2⟩
    have e1 : (↑U⁻¹ : Matrix Four Four ℂ)ᴴ * (U : Matrix Four Four ℂ)ᴴ = 1 := by
      rw [← Matrix.conjTranspose_mul, Units.mul_inv, Matrix.conjTranspose_one]
    have e2 : (U : Matrix Four Four ℂ) * (↑U⁻¹ : Matrix Four Four ℂ) = 1 := Units.mul_inv U
    refine ⟨?_, ?_⟩
    · have h1 : (U : Matrix Four Four ℂ).det * (↑U⁻¹ : Matrix Four Four ℂ).det = 1 := by
        rw [← Matrix.det_mul, e2, Matrix.det_one]
      rw [hU1, one_mul] at h1
      exact h1
    · calc (↑U⁻¹ : Matrix Four Four ℂ)ᴴ * h * (↑U⁻¹ : Matrix Four Four ℂ) =
            (↑U⁻¹ : Matrix Four Four ℂ)ᴴ * ((U : Matrix Four Four ℂ)ᴴ * h * U) *
              (↑U⁻¹ : Matrix Four Four ℂ) := by
              rw [hU2]
        _ = ((↑U⁻¹ : Matrix Four Four ℂ)ᴴ * (U : Matrix Four Four ℂ)ᴴ) * h *
              ((U : Matrix Four Four ℂ) * (↑U⁻¹ : Matrix Four Four ℂ)) := by simp only [Matrix.mul_assoc]
        _ = h := by rw [e1, e2, Matrix.one_mul, Matrix.mul_one]

theorem map_star_mul (A B : Matrix Four Four ℂ) : (A * B).map star = A.map star * B.map star := by
  have h := RingHom.map_mul (starRingEnd ℂ).mapMatrix A B
  simpa [RingHom.mapMatrix_apply] using h

theorem map_star_one : (1 : Matrix Four Four ℂ).map star = 1 := by
  ext i j
  simp [Matrix.one_apply]

/-- The rotations of determinant one that commute with the antilinear `v ↦ Mv̄`: `UM = MŪ`. -/
def antiGroup (M : Matrix Four Four ℂ) : Subgroup (Matrix Four Four ℂ)ˣ where
  carrier := {U | (U : Matrix Four Four ℂ).det = 1 ∧
    (U : Matrix Four Four ℂ) * M = M * (U : Matrix Four Four ℂ).map star}
  one_mem' := by simp
  mul_mem' := by
    rintro U V ⟨hU1, hU2⟩ ⟨hV1, hV2⟩
    refine ⟨by rw [Units.val_mul, Matrix.det_mul, hU1, hV1, one_mul], ?_⟩
    rw [Units.val_mul, map_star_mul, Matrix.mul_assoc, hV2, ← Matrix.mul_assoc, hU2,
      Matrix.mul_assoc]
  inv_mem' := by
    rintro U ⟨hU1, hU2⟩
    have e2 : (U : Matrix Four Four ℂ) * (↑U⁻¹ : Matrix Four Four ℂ) = 1 := Units.mul_inv U
    have e3 : (↑U⁻¹ : Matrix Four Four ℂ) * U = 1 := Units.inv_mul U
    have e4 : (U : Matrix Four Four ℂ).map star * (↑U⁻¹ : Matrix Four Four ℂ).map star = 1 := by
      rw [← map_star_mul, e2, map_star_one]
    refine ⟨?_, ?_⟩
    · have h1 : (U : Matrix Four Four ℂ).det * (↑U⁻¹ : Matrix Four Four ℂ).det = 1 := by
        rw [← Matrix.det_mul, e2, Matrix.det_one]
      rw [hU1, one_mul] at h1
      exact h1
    · calc (↑U⁻¹ : Matrix Four Four ℂ) * M =
            (↑U⁻¹ : Matrix Four Four ℂ) * M *
              ((U : Matrix Four Four ℂ).map star * (↑U⁻¹ : Matrix Four Four ℂ).map star) := by
              rw [e4, Matrix.mul_one]
        _ = (↑U⁻¹ : Matrix Four Four ℂ) * ((U : Matrix Four Four ℂ) * M) *
              (↑U⁻¹ : Matrix Four Four ℂ).map star := by
              rw [hU2]; simp only [Matrix.mul_assoc]
        _ = M * (↑U⁻¹ : Matrix Four Four ℂ).map star := by
              rw [← Matrix.mul_assoc, e3, Matrix.one_mul]

/-! ## The exponentials lie in the groups -/

/-- If `X†h + hX = 0`, `h² = 1` and `tr X = 0`, then `e^X` has determinant one and keeps `h`. -/
theorem exp_mem_formGroup (h X : Matrix Four Four ℂ) (hh : h * h = 1)
    (hX : Xᴴ * h + h * X = 0) (htr : X.trace = 0) :
    (NormedSpace.exp X).det = 1 ∧ (NormedSpace.exp X)ᴴ * h * NormedSpace.exp X = h := by
  refine ⟨det_exp_of_trace_zero X htr, ?_⟩
  have hinv : h⁻¹ = h := Matrix.inv_eq_left_inv hh
  have hunit : IsUnit h := ⟨⟨h, h, hh, hh⟩, rfl⟩
  have hXH : Xᴴ = h * (-X) * h⁻¹ := by
    rw [hinv]
    have e : Xᴴ * h = -(h * X) := eq_neg_of_add_eq_zero_left hX
    calc Xᴴ = Xᴴ * h * h := by rw [Matrix.mul_assoc, hh, Matrix.mul_one]
      _ = h * (-X) * h := by rw [e, Matrix.mul_neg, Matrix.neg_mul]
  have hexpH : (NormedSpace.exp X)ᴴ = h * NormedSpace.exp (-X) * h⁻¹ := by
    rw [← Matrix.exp_conjTranspose, hXH, Matrix.exp_conj _ _ hunit]
  have hunitX := Matrix.isUnit_exp X
  rw [hexpH, hinv, Matrix.exp_neg]
  calc h * (NormedSpace.exp X)⁻¹ * h * h * NormedSpace.exp X =
        h * ((NormedSpace.exp X)⁻¹ * (h * h) * NormedSpace.exp X) := by
          simp only [Matrix.mul_assoc]
    _ = h := by
          rw [hh, Matrix.mul_one,
            Matrix.nonsing_inv_mul _ ((Matrix.isUnit_iff_isUnit_det _).mp hunitX), Matrix.mul_one]

theorem exp_map_star (X : Matrix Four Four ℂ) :
    NormedSpace.exp (X.map star) = (NormedSpace.exp X).map star := by
  have e : X.map star = (Xᴴ)ᵀ := by
    ext i j
    simp [Matrix.conjTranspose_apply, Matrix.transpose_apply]
  have e' : (NormedSpace.exp X).map star = ((NormedSpace.exp X)ᴴ)ᵀ := by
    ext i j
    simp [Matrix.conjTranspose_apply, Matrix.transpose_apply]
  rw [e, e', Matrix.exp_transpose, Matrix.exp_conjTranspose]

/-- If `XM = MX̄`, `M` invertible and `tr X = 0`, then `e^X` has determinant one and
`e^X M = M conj(e^X)`. -/
theorem exp_mem_antiGroup (M X : Matrix Four Four ℂ) (hM : IsUnit M)
    (hX : X * M = M * X.map star) (htr : X.trace = 0) :
    (NormedSpace.exp X).det = 1 ∧
      NormedSpace.exp X * M = M * (NormedSpace.exp X).map star := by
  refine ⟨det_exp_of_trace_zero X htr, ?_⟩
  have hdet : IsUnit M.det := (Matrix.isUnit_iff_isUnit_det _).mp hM
  have hX' : X = M * X.map star * M⁻¹ := by
    calc X = X * M * M⁻¹ := by rw [Matrix.mul_assoc, Matrix.mul_nonsing_inv _ hdet, Matrix.mul_one]
      _ = M * X.map star * M⁻¹ := by rw [hX]
  have hexp : NormedSpace.exp X = M * NormedSpace.exp (X.map star) * M⁻¹ := by
    conv_lhs => rw [hX']
    rw [Matrix.exp_conj _ _ hM]
  conv_lhs => rw [hexp, exp_map_star]
  rw [Matrix.mul_assoc, Matrix.nonsing_inv_mul _ hdet, Matrix.mul_one]

/-! ## The real forms of the divisions of the lines -/

theorem gammaDJ_mul_conj (D : Finset (Fin 5)) :
    (gammaD D * J) * (gammaD D * J).map star = (countSign D.card : ℂ) • 1 := by
  have h := congrArg (fun A => A.map GaussianInt.toComplex) (gammaDZ_C_sq D)
  simp only [Matrix.map_mul, star_mapZ, gammaDZ_map, JZ_map] at h
  rw [h]
  ext i j
  simp [Matrix.one_apply]
  split_ifs <;> simp

theorem isUnit_gammaDJ (D : Finset (Fin 5)) : IsUnit (gammaD D * J) := by
  have hcs : (countSign D.card : ℂ) ≠ 0 := by
    unfold countSign; split_ifs <;> simp
  have h1 : (gammaD D * J) * (((countSign D.card : ℂ))⁻¹ • (gammaD D * J).map star) = 1 := by
    rw [Matrix.mul_smul, gammaDJ_mul_conj, smul_smul, inv_mul_cancel₀ hcs, one_smul]
  exact ⟨⟨_, _, h1, mul_eq_one_comm.mp h1⟩, rfl⟩

/-- **The real form of an even division of the lines lies in the group of its form:**
`realForm (P_D) ≤ {U : det U = 1, U†h_DU = h_D}`. -/
theorem realForm_le_formGroup (D : Finset (Fin 5)) (hD : D.card % 2 = 0) :
    realForm (projOf (linesDiv D)) ≤ formGroup (hermForm D) := by
  rw [realForm, Subgroup.closure_le]
  rintro U ⟨X, hX, hU⟩
  obtain ⟨htr, hform⟩ := (realFormAlg_lines_even D hD X).mp hX
  have hh : hermForm D * hermForm D = 1 := (hermForm_props D hD).2.1
  obtain ⟨h1, h2⟩ := exp_mem_formGroup _ X hh hform htr
  exact ⟨by rw [hU]; exact h1, by rw [hU]; exact h2⟩

/-- **The real form of an odd division of the lines lies in the group of its antilinear map:**
`realForm (P_D) ≤ {U : det U = 1, UC_D = C_DU}`. -/
theorem realForm_le_antiGroup (D : Finset (Fin 5)) (hD : D.card % 2 = 1) :
    realForm (projOf (linesDiv D)) ≤ antiGroup (gammaD D * J) := by
  rw [realForm, Subgroup.closure_le]
  rintro U ⟨X, hX, hU⟩
  obtain ⟨htr, hC⟩ := (realFormAlg_lines_odd D hD X).mp hX
  obtain ⟨h1, h2⟩ := exp_mem_antiGroup _ X (isUnit_gammaDJ D) hC htr
  exact ⟨by rw [hU]; exact h1, by rw [hU]; exact h2⟩

/-- The form of the point (no line divided) is `1`, so its group is `SU(4)`. -/
theorem formGroup_one_iff (U : (Matrix Four Four ℂ)ˣ) :
    U ∈ formGroup 1 ↔ (U : Matrix Four Four ℂ).det = 1 ∧ (U : Matrix Four Four ℂ)ᴴ * U = 1 := by
  change (_ ∧ _) ↔ _
  rw [Matrix.mul_one]

end Geometry


import Comparison.System.Geometry.RealFormAll

/-!
# The geometry of comparison: the real form of the point is `SU(4)`

The group generated by the exponentials of
`su(4)` (Definition 15's real form of the division that divides nothing) is all of `SU(4)`
(`realForm_point_iff`).

The proof reads the construction of `GroupsContinuumLaw.rot6_onto` with exponentials: a rotation `U ∈ SU(4)` acts
on the six as a rotation, which is a boost `cos θ + sin θ·iγ(m) = e^{θ·iγ(m)}` times the lift of a
rotation of the five directions; that rotation is a product of reflections, each lifted to a line
`γ(w) = (−i)·e^{(π/2)·iγ(w)}`, with `i·1 = e^{diag(iπ/2, iπ/2, iπ/2, −3iπ/2)}` and `−i·1 = (i·1)³`;
and two rotations with the same rotation differ by `±1`, `−1 = e^{π·iγ₀}`.
-/

open scoped InnerProductSpace Kronecker ComplexOrder
open Matrix Complex Module

namespace Comparison.System

namespace Geometry

/-! ## The real form of the point and its elements -/

/-- The real form of the point (no direction divided). -/
noncomputable abbrev RF0 : Subgroup (Matrix Four Four ℂ)ˣ := realForm (projOf (linesDiv ∅))

/-- `M` is the matrix of an element of `RF0`. -/
def InRF0 (M : Matrix Four Four ℂ) : Prop := ∃ u ∈ RF0, (u : Matrix Four Four ℂ) = M

theorem hermForm_empty : hermForm ∅ = 1 := by
  simp [hermForm, gammaD]

theorem su4_mem_realFormAlg0 (X : Matrix Four Four ℂ) (hX : Xᴴ = -X) (htr : X.trace = 0) :
    X ∈ realFormAlg (projOf (linesDiv ∅)) := by
  rw [realFormAlg_lines_even ∅ (by decide)]
  refine ⟨htr, ?_⟩
  rw [hermForm_empty, Matrix.mul_one, Matrix.one_mul, hX, neg_add_cancel]

theorem exp_mul_exp_neg (X : Matrix Four Four ℂ) :
    NormedSpace.exp X * NormedSpace.exp (-X) = 1 := by
  rw [← Matrix.exp_add_of_commute _ _ ((Commute.refl X).neg_right), add_neg_cancel,
    NormedSpace.exp_zero]

theorem exp_neg_mul_exp (X : Matrix Four Four ℂ) :
    NormedSpace.exp (-X) * NormedSpace.exp X = 1 := by
  rw [← Matrix.exp_add_of_commute _ _ ((Commute.refl X).neg_left), neg_add_cancel,
    NormedSpace.exp_zero]

theorem inRF0_exp (X : Matrix Four Four ℂ) (hX : Xᴴ = -X) (htr : X.trace = 0) :
    InRF0 (NormedSpace.exp X) :=
  ⟨⟨NormedSpace.exp X, NormedSpace.exp (-X), exp_mul_exp_neg X, exp_neg_mul_exp X⟩,
    Subgroup.subset_closure ⟨X, su4_mem_realFormAlg0 X hX htr, rfl⟩, rfl⟩

theorem inRF0_one : InRF0 1 := ⟨1, RF0.one_mem, rfl⟩

theorem inRF0_mul {A B : Matrix Four Four ℂ} (hA : InRF0 A) (hB : InRF0 B) : InRF0 (A * B) := by
  obtain ⟨u, hu, rfl⟩ := hA
  obtain ⟨v, hv, rfl⟩ := hB
  exact ⟨u * v, RF0.mul_mem hu hv, Units.val_mul u v⟩

/-- For a Hermitian `Y` of trace zero with `Y² = 1`, `iY` is anti-Hermitian of trace zero with
square `−1`. -/
theorem iY_props (Y : Matrix Four Four ℂ) (hH : Yᴴ = Y) (htr : Y.trace = 0) (hsq : Y * Y = 1) :
    (Complex.I • Y)ᴴ = -(Complex.I • Y) ∧ (Complex.I • Y).trace = 0 ∧
      (Complex.I • Y) * (Complex.I • Y) = -1 := by
  refine ⟨?_, ?_, ?_⟩
  · rw [Matrix.conjTranspose_smul, hH, Complex.star_def, Complex.conj_I, neg_smul]
  · rw [Matrix.trace_smul, htr, smul_zero]
  · rw [Matrix.smul_mul, Matrix.mul_smul, smul_smul, hsq, Complex.I_mul_I, neg_one_smul]

/-- A real multiple of an anti-Hermitian matrix of trace zero has its exponential in `RF0`. -/
theorem inRF0_exp_smul (a : ℝ) (X : Matrix Four Four ℂ) (hX : Xᴴ = -X) (htr : X.trace = 0) :
    InRF0 (NormedSpace.exp ((a : ℂ) • X)) := by
  apply inRF0_exp
  · rw [Matrix.conjTranspose_smul, hX, Complex.star_def, Complex.conj_ofReal, smul_neg]
  · rw [Matrix.trace_smul, htr, smul_zero]

/-- `−1 = e^{π·iγ₀}` lies in `RF0`. -/
theorem inRF0_neg_one : InRF0 (-1) := by
  obtain ⟨hH, htr, hsq⟩ := iY_props (γ 0) (γ_conjTranspose 0) (γ_trace 0) (γ_mul_self 0)
  have h := exp_smul_of_sq (Complex.I • γ 0) hsq Real.pi
  rw [Real.cos_pi, Real.sin_pi] at h
  have h1 : NormedSpace.exp ((Real.pi : ℂ) • (Complex.I • γ 0)) = -1 := by
    rw [h]
    simp
  rw [← h1]
  exact inRF0_exp_smul Real.pi _ hH htr

/-- The diagonal generator of `i·1`. -/
noncomputable def diagI : Matrix Four Four ℂ :=
  Matrix.diagonal fun p : Four =>
    if p = (1, 1) then -(((3 * Real.pi / 2 : ℝ)) : ℂ) * Complex.I else ((Real.pi / 2 : ℝ) : ℂ) * Complex.I

theorem exp_halfPiI : Complex.exp (((Real.pi / 2 : ℝ) : ℂ) * Complex.I) = Complex.I := by
  rw [Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin, Real.cos_pi_div_two,
    Real.sin_pi_div_two]
  simp

theorem exp_threeHalfPiI : Complex.exp (-(((3 * Real.pi / 2 : ℝ)) : ℂ) * Complex.I) = Complex.I := by
  have e : -(((3 * Real.pi / 2 : ℝ)) : ℂ) * Complex.I =
      ((Real.pi / 2 : ℝ) : ℂ) * Complex.I + -(2 * (Real.pi : ℂ) * Complex.I) := by
    push_cast
    ring
  rw [e, Complex.exp_add, exp_halfPiI, Complex.exp_neg, Complex.exp_two_pi_mul_I, inv_one, mul_one]

theorem exp_diagI : NormedSpace.exp diagI = Complex.I • (1 : Matrix Four Four ℂ) := by
  rw [diagI, Matrix.exp_diagonal]
  ext i j
  rw [Matrix.diagonal_apply, Matrix.smul_apply, Matrix.one_apply]
  by_cases hij : i = j
  · subst hij
    rw [if_pos rfl, if_pos rfl, smul_eq_mul, mul_one, Pi.coe_exp, ← Complex.exp_eq_exp_ℂ]
    split_ifs
    · exact exp_threeHalfPiI
    · exact exp_halfPiI
  · rw [if_neg hij, if_neg hij, smul_zero]

theorem diagI_conjTranspose : diagIᴴ = -diagI := by
  rw [diagI, Matrix.diagonal_conjTranspose, Matrix.diagonal_neg]
  congr 1
  funext p
  simp only [Pi.star_apply]
  split_ifs <;> simp [Complex.conj_ofReal]

theorem diagI_trace : diagI.trace = 0 := by
  rw [diagI, Matrix.trace_diagonal, Fintype.sum_prod_type, Fin.sum_univ_two, Fin.sum_univ_two,
    Fin.sum_univ_two]
  simp only [Prod.mk.injEq]
  norm_num
  push_cast
  ring

theorem inRF0_I : InRF0 (Complex.I • (1 : Matrix Four Four ℂ)) := by
  rw [← exp_diagI]
  exact inRF0_exp _ diagI_conjTranspose diagI_trace

theorem inRF0_negI : InRF0 ((-Complex.I) • (1 : Matrix Four Four ℂ)) := by
  have e : (-Complex.I) • (1 : Matrix Four Four ℂ) =
      (Complex.I • (1 : Matrix Four Four ℂ)) *
        ((Complex.I • (1 : Matrix Four Four ℂ)) * (Complex.I • (1 : Matrix Four Four ℂ))) := by
    rw [Matrix.smul_mul, Matrix.smul_mul, Matrix.mul_smul, Matrix.mul_smul, Matrix.one_mul,
      smul_smul, smul_smul, Matrix.one_mul, Complex.I_mul_I, neg_one_mul]
  rw [e]
  exact inRF0_mul inRF0_I (inRF0_mul inRF0_I inRF0_I)

/-- A unit line `γ(w) = (−i)·e^{(π/2)·iγ(w)}` lies in `RF0`. -/
theorem inRF0_line (w : GroupsContinuumLaw.E5) (hw : ∑ s, w s ^ 2 = 1) : InRF0 (GroupsContinuumLaw.gE w) := by
  have hsq : GroupsContinuumLaw.gE w * GroupsContinuumLaw.gE w = 1 := by
    rw [GroupsContinuumLaw.gE_sq, hw]
    simp
  obtain ⟨hH, htr, hsq'⟩ := iY_props (GroupsContinuumLaw.gE w) (GroupsContinuumLaw.gE_hermitian w)
    (GroupsContinuumLaw.gE_isDistinction w).2.1 hsq
  have h := exp_smul_of_sq (Complex.I • GroupsContinuumLaw.gE w) hsq' (Real.pi / 2)
  rw [Real.cos_pi_div_two, Real.sin_pi_div_two] at h
  have h1 : NormedSpace.exp (((Real.pi / 2 : ℝ) : ℂ) • (Complex.I • GroupsContinuumLaw.gE w)) =
      Complex.I • GroupsContinuumLaw.gE w := by
    rw [h]
    simp
  have e : GroupsContinuumLaw.gE w = ((-Complex.I) • (1 : Matrix Four Four ℂ)) *
      NormedSpace.exp (((Real.pi / 2 : ℝ) : ℂ) • (Complex.I • GroupsContinuumLaw.gE w)) := by
    rw [h1, Matrix.smul_mul, Matrix.one_mul, smul_smul, neg_mul, Complex.I_mul_I, neg_neg, one_smul]
  rw [e]
  exact inRF0_mul inRF0_negI (inRF0_exp_smul _ _ hH htr)

/-- A boost `c + s·iγ(m)` (`c² + s² = 1`, `s ≥ 0`, `|m| = 1`) is `e^{θ·iγ(m)}` and lies in `RF0`. -/
theorem inRF0_boost (c s : ℝ) (m : GroupsContinuumLaw.E5) (hcs : c ^ 2 + s ^ 2 = 1) (hm : ∑ k, m k ^ 2 = 1)
    (hs : 0 ≤ s) : InRF0 (GroupsContinuumLaw.boostM c s m) := by
  have hc1 : c ≤ 1 := by nlinarith
  have hc2 : -1 ≤ c := by nlinarith
  set θ := Real.arccos c with hθ
  have hcos : Real.cos θ = c := Real.cos_arccos hc2 hc1
  have hsin : Real.sin θ = s := by
    rw [hθ, Real.sin_arccos]
    have : 1 - c ^ 2 = s ^ 2 := by linarith
    rw [this, Real.sqrt_sq hs]
  have hK := GroupsContinuumLaw.Kmat_sq m hm
  have hKH : (GroupsContinuumLaw.Kmat m)ᴴ = -GroupsContinuumLaw.Kmat m := by
    rw [GroupsContinuumLaw.Kmat, Matrix.conjTranspose_smul, GroupsContinuumLaw.gE_hermitian, Complex.star_def,
      Complex.conj_I, neg_smul]
  have hKtr : (GroupsContinuumLaw.Kmat m).trace = 0 := by
    rw [GroupsContinuumLaw.Kmat, Matrix.trace_smul, (GroupsContinuumLaw.gE_isDistinction m).2.1, smul_zero]
  have h := exp_smul_of_sq (GroupsContinuumLaw.Kmat m) hK θ
  rw [hcos, hsin] at h
  have e : GroupsContinuumLaw.boostM c s m = NormedSpace.exp ((θ : ℂ) • GroupsContinuumLaw.Kmat m) := by
    rw [h, GroupsContinuumLaw.boostM]
  rw [e]
  exact inRF0_exp_smul θ _ hKH hKtr

/-! ## The construction of `rot6_onto`, read with exponentials -/

/-- Every product of reflections of the five directions is `±R_W` for a `W ∈ Sp(2)` in `RF0`. -/
theorem realize_RF (l : List GroupsContinuumLaw.E5) :
    ∃ W : GroupsContinuumLaw.Sp2, (∀ x, (l.map GroupsContinuumLaw.refl).prod x =
      ((-1 : ℝ) ^ GroupsContinuumLaw.nz l) • GroupsContinuumLaw.rotV W x) ∧ InRF0 (GroupsContinuumLaw.mat W) := by
  induction l with
  | nil =>
    refine ⟨1, fun x => by simp [GroupsContinuumLaw.nz, GroupsContinuumLaw.rotV_one], ?_⟩
    rw [GroupsContinuumLaw.mat_one]
    exact inRF0_one
  | cons v l ih =>
    obtain ⟨W, hW, hWm⟩ := ih
    by_cases hv : v = 0
    · refine ⟨W, fun x => ?_, hWm⟩
      rw [List.map_cons, List.prod_cons, LinearIsometryEquiv.coe_mul, Function.comp_apply, hW,
        GroupsContinuumLaw.refl, GroupsContinuumLaw.refl_apply, hv]
      simp [GroupsContinuumLaw.nz, List.countP_cons]
    · have hn : ‖v‖ ≠ 0 := norm_ne_zero_iff.2 hv
      set w : GroupsContinuumLaw.E5 := ‖v‖⁻¹ • v with hw
      have hw1 : ∑ s, w s ^ 2 = 1 := by
        rw [← GroupsContinuumLaw.norm_sq_E5, hw, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hn, one_pow]
      refine ⟨GroupsContinuumLaw.lineElt w hw1 * W, fun x => ?_, ?_⟩
      · have hrefl : ∀ y, GroupsContinuumLaw.refl v y = -GroupsContinuumLaw.rotV (GroupsContinuumLaw.lineElt w hw1) y := by
          intro y
          rw [GroupsContinuumLaw.rot_lineElt, neg_neg, GroupsContinuumLaw.refl, GroupsContinuumLaw.refl_apply, GroupsContinuumLaw.refl_apply, hw,
            real_inner_smul_left, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hn, one_pow, div_one,
            smul_smul]
          congr 2
          field_simp
        rw [List.map_cons, List.prod_cons, LinearIsometryEquiv.coe_mul, Function.comp_apply, hW,
          hrefl, GroupsContinuumLaw.rotV_mul, GroupsContinuumLaw.rotV_smul]
        simp [GroupsContinuumLaw.nz, List.countP_cons, hv, pow_succ]
      · rw [GroupsContinuumLaw.mat_mul, GroupsContinuumLaw.mat_lineElt]
        exact inRF0_mul (inRF0_line w hw1) hWm

/-- Every rotation of the five directions is `R_W` for a `W ∈ Sp(2)` in `RF0`. -/
theorem rot_onto_RF (φ : GroupsContinuumLaw.E5 ≃ₗᵢ[ℝ] GroupsContinuumLaw.E5) (hφ : LinearMap.det φ.toLinearMap = 1) :
    ∃ U : GroupsContinuumLaw.Sp2, GroupsContinuumLaw.rotHom U = φ ∧ InRF0 (GroupsContinuumLaw.mat U) := by
  obtain ⟨l, -, hl⟩ := φ.reflections_generate_dim
  obtain ⟨W, hW, hWm⟩ := realize_RF l
  have hdet : LinearMap.det φ.toLinearMap = (-1 : ℝ) ^ GroupsContinuumLaw.nz l := by
    rw [show φ = (l.map fun v => (ℝ ∙ v)ᗮ.reflection).prod from hl]
    exact GroupsContinuumLaw.det_prod_refl l
  rw [hφ] at hdet
  refine ⟨W, LinearIsometryEquiv.ext fun x => ?_, hWm⟩
  rw [GroupsContinuumLaw.rotHom_apply, show φ = (l.map GroupsContinuumLaw.refl).prod from hl, hW, ← hdet, one_smul]

/-- Every rotation of the six is `R_U` for a `U ∈ SU(4)` in `RF0`. -/
theorem rot6_onto_RF (φ : GroupsContinuumLaw.E6 ≃ₗᵢ[ℝ] GroupsContinuumLaw.E6) (hφ : LinearMap.det φ.toLinearMap = 1) :
    ∃ U : GroupsContinuumLaw.SU4, GroupsContinuumLaw.rot6Hom U = φ ∧ InRF0 (U : Matrix Four Four ℂ) := by
  have hn : ∑ a, φ GroupsContinuumLaw.e0 a ^ 2 = 1 := by
    rw [← EuclideanSpace.real_norm_sq_eq, LinearIsometryEquiv.norm_map]
    simp [GroupsContinuumLaw.e0]
  obtain ⟨c, s, m, hcs, hm, hs, hB⟩ := GroupsContinuumLaw.exists_boost _ hn
  set B := GroupsContinuumLaw.boost c s m hcs hm
  set ψ : GroupsContinuumLaw.E6 ≃ₗᵢ[ℝ] GroupsContinuumLaw.E6 := GroupsContinuumLaw.rot6Hom (star B) * φ with hψ
  have hψ0 : ψ GroupsContinuumLaw.e0 = GroupsContinuumLaw.e0 := by
    rw [hψ, LinearIsometryEquiv.coe_mul, Function.comp_apply, GroupsContinuumLaw.rot6Hom_apply, ← hB,
      ← GroupsContinuumLaw.rot6V_mul, GroupsContinuumLaw.su4_star_mul, GroupsContinuumLaw.rot6V_one]
  have hperp : ∀ x, ψ (GroupsContinuumLaw.embL x) 0 = 0 := by
    intro x
    have h := LinearIsometryEquiv.inner_map_map ψ GroupsContinuumLaw.e0 (GroupsContinuumLaw.embL x)
    rw [hψ0] at h
    have h1 : ∀ y : GroupsContinuumLaw.E6, inner ℝ GroupsContinuumLaw.e0 y = y 0 := fun y => by
      simp [GroupsContinuumLaw.e0, EuclideanSpace.inner_single_left]
    rw [h1, h1, GroupsContinuumLaw.embL_zero] at h
    exact h
  have hemb : ∀ x, ψ (GroupsContinuumLaw.embL x) = GroupsContinuumLaw.embL (GroupsContinuumLaw.tailL (ψ (GroupsContinuumLaw.embL x))) := by
    intro x
    conv_lhs => rw [GroupsContinuumLaw.decomp_six (ψ (GroupsContinuumLaw.embL x))]
    rw [hperp, zero_smul, zero_add]
  let gL : GroupsContinuumLaw.E5 →ₗᵢ[ℝ] GroupsContinuumLaw.E5 :=
    { toLinearMap := GroupsContinuumLaw.tailL ∘ₗ ψ.toLinearMap ∘ₗ GroupsContinuumLaw.embL
      norm_map' := fun x => by
        change ‖GroupsContinuumLaw.tailL (ψ (GroupsContinuumLaw.embL x))‖ = ‖x‖
        rw [← GroupsContinuumLaw.norm_embL, ← hemb, LinearIsometryEquiv.norm_map, GroupsContinuumLaw.norm_embL] }
  let g : GroupsContinuumLaw.E5 ≃ₗᵢ[ℝ] GroupsContinuumLaw.E5 := gL.toLinearIsometryEquiv rfl
  have hg : ∀ x, ψ (GroupsContinuumLaw.embL x) = GroupsContinuumLaw.embL (g x) := fun x => hemb x
  have hdetψ : LinearMap.det ψ.toLinearMap = 1 := by
    rw [hψ, GroupsContinuumLaw.det_mul_isometry, GroupsContinuumLaw.rot6_det, hφ, one_mul]
  have hdetg : LinearMap.det g.toLinearMap = 1 := by
    rw [← GroupsContinuumLaw.det_block ψ.toLinearMap g.toLinearMap hψ0 hg, hdetψ]
  obtain ⟨W, hW, hWm⟩ := rot_onto_RF g hdetg
  refine ⟨B * GroupsContinuumLaw.toSU4 W, LinearIsometryEquiv.ext fun t => ?_, ?_⟩
  · have hψt : ψ t = GroupsContinuumLaw.rot6V (GroupsContinuumLaw.toSU4 W) t := by
      conv_lhs => rw [GroupsContinuumLaw.decomp_six t]
      conv_rhs => rw [GroupsContinuumLaw.decomp_six t]
      rw [LinearIsometryEquiv.map_add, LinearIsometryEquiv.map_smul, hψ0, hg, GroupsContinuumLaw.rot6V_add,
        GroupsContinuumLaw.rot6V_smul, GroupsContinuumLaw.rot6_sp2_e0, GroupsContinuumLaw.rot6_sp2_emb, ← GroupsContinuumLaw.rotHom_apply, hW]
    rw [GroupsContinuumLaw.rot6Hom_apply, GroupsContinuumLaw.rot6V_mul, ← hψt, hψ, LinearIsometryEquiv.coe_mul,
      Function.comp_apply, GroupsContinuumLaw.rot6Hom_apply, ← GroupsContinuumLaw.rot6V_mul, GroupsContinuumLaw.su4_mul_star,
      GroupsContinuumLaw.rot6V_one]
  · change InRF0 (GroupsContinuumLaw.boostM c s m * GroupsContinuumLaw.mat W)
    exact inRF0_mul (inRF0_boost c s m hcs hm hs) hWm

/-- **Every rotation of `SU(4)` lies in the real form of the point.** -/
theorem su4_inRF0 (U : GroupsContinuumLaw.SU4) : InRF0 (U : Matrix Four Four ℂ) := by
  obtain ⟨U', hU', hm⟩ := rot6_onto_RF (GroupsContinuumLaw.rot6Hom U) (GroupsContinuumLaw.rot6_det U)
  have h1 : GroupsContinuumLaw.rot6Hom (star U' * U) = 1 := by
    rw [map_mul, ← hU', ← map_mul, GroupsContinuumLaw.su4_star_mul, map_one]
  have hU'm : (U' : Matrix Four Four ℂ) * star (U' : Matrix Four Four ℂ) = 1 :=
    congrArg Subtype.val (GroupsContinuumLaw.su4_mul_star U')
  rcases (GroupsContinuumLaw.rot6_ker (star U' * U)).mp h1 with h | h
  · have e : (U : Matrix Four Four ℂ) = U' := by
      have h' : star (U' : Matrix Four Four ℂ) * U = 1 := h
      calc (U : Matrix Four Four ℂ) = ((U' : Matrix Four Four ℂ) * star (U' : Matrix Four Four ℂ)) * U := by
            rw [hU'm, Matrix.one_mul]
        _ = U' := by rw [Matrix.mul_assoc, h', Matrix.mul_one]
    rw [e]
    exact hm
  · have e : (U : Matrix Four Four ℂ) = -1 * U' := by
      have h' : star (U' : Matrix Four Four ℂ) * U = -1 := h
      calc (U : Matrix Four Four ℂ) = ((U' : Matrix Four Four ℂ) * star (U' : Matrix Four Four ℂ)) * U := by
            rw [hU'm, Matrix.one_mul]
        _ = -1 * U' := by rw [Matrix.mul_assoc, h', Matrix.mul_neg, Matrix.mul_one, Matrix.neg_mul,
            Matrix.one_mul]
    rw [e]
    exact inRF0_mul inRF0_neg_one hm

/-- **The real form of the point is `SU(4)`:** a unit of the matrices lies in the group generated by
the exponentials of `su(4)` exactly when it has determinant one and is unitary. -/
theorem realForm_point_iff (U : (Matrix Four Four ℂ)ˣ) :
    U ∈ realForm (projOf (linesDiv ∅)) ↔
      (U : Matrix Four Four ℂ).det = 1 ∧ (U : Matrix Four Four ℂ)ᴴ * U = 1 := by
  constructor
  · intro h
    have h1 := realForm_le_formGroup ∅ (by decide) h
    rw [hermForm_empty] at h1
    exact (formGroup_one_iff U).mp h1
  · rintro ⟨hdet, hu⟩
    have hmem : (U : Matrix Four Four ℂ) ∈ Matrix.specialUnitaryGroup Four ℂ := by
      rw [Matrix.mem_specialUnitaryGroup_iff]
      refine ⟨Matrix.mem_unitaryGroup_iff'.mpr ?_, hdet⟩
      rwa [Matrix.star_eq_conjTranspose]
    obtain ⟨u, hu', hval⟩ := su4_inRF0 ⟨U, hmem⟩
    have e : u = U := Units.ext hval
    rw [← e]
    exact hu'

end Geometry

open Comparison.System.Geometry

/-- **Proposition 21 (four types of division).** Under the fifteen rotations a division (a subspace `D`
of P1's real six) is known by the dimension `k` of its smaller part: two divisions are carried one to
the other by a rotation of `SU(4)` exactly when they have the same type, there are four types,
`k = 0, 1, 2, 3`, each that of a coordinate division; in a basis, a division `D ⊆ {0, …, 5}` keeps
`C(k,2) + C(6−k,2) = 15, 10, 7, 6` and moves `k(6 − k) = 0, 5, 8, 9` of the fifteen generators,
each generator kept or moved and not both; its metric is `Σ_{a∉D} v_a² − Σ_{a∈D} v_a²`
(signature `(6−k, k)`); for the divisions of the lines with the singlet undivided (the Lemma and its
converse), the real form's Lie algebra is `{X : tr X = 0, X†h_D + h_DX = 0}` (`r` even, `h_D`
Hermitian, `h_D² = 1`, trace zero for `r = 2, 4`) or `{X : tr X = 0, XC_D = C_DX}` (`r` odd,
`C_D² = −1` for `r = 1, 5`, `+1` for `r = 3`), of real dimension 15; on the six these real forms are
`so(6 − k, k)`; the balanced lines are `(S^{5−k} × S^{k−1})/ℤ₂`, and at `2|4` the metric has the signs
`(+, −, −, −)` on `v^⊥/ℝv`. Definition 15's real form in a basis: for every set `S` of directions,
`realFormAlg` is the real span of the kept rotations and `i` times the moved ones, the same for `S` and its
complement, and every generator is one kept plus one moved; the group it generates lies in
`{U : det U = 1, U†h_DU = h_D}` (`r` even) or `{U : det U = 1, UC_D = C_DU}` (`r` odd).
Every division is a coordinate division in a rotated basis, `P = R·P_S·Rᵀ`, its real form is the
real form of `S` turned by the lift `U` of `R`, and its kept and moved generators are those of `S` turned
by `R`. The real form of the point is all of `SU(4)`. Status: partial; missing (b): that the group generated
is all of `SU(2,2)`, `SU*(4)`, `SL(4,ℝ)` (every element a product of exponentials of the real form).
Recognition: the four types are those of gravity, the weak force, electromagnetism and
the strong force; the real forms `su(4)`, `sl(2,ℍ)`, `su(2,2)`, `sl(4,ℝ)` of the twistor group; the
balance `(1, 3)` of `2|4` is spacetime. -/
theorem prop_21 :
    (
      (∀ D D' : Division, Division.ByTurn D D' ↔ Division.kind D = Division.kind D') ∧
      (∀ D : Division, Division.kind D ≤ 3) ∧
      (∀ k ≤ 3, ∃ S : Finset (Fin 6), S.card = k ∧ Division.kind (Division.ofSet S) = k) ∧
      (∀ S : Finset (Fin 6), finrank ℝ (Division.ofSet S) = S.card) ∧
      (∀ D : Finset (Fin 6), (Finset.univ.filter (Kept D)).card =
        D.card.choose 2 + (6 - D.card).choose 2) ∧
      (∀ D : Finset (Fin 6), (Finset.univ.filter (Moved D)).card = D.card * (6 - D.card)) ∧
      (∀ (D : Finset (Fin 6)) (x : Fin 5 ⊕ Fin 10), Kept D x ↔ ¬ Moved D x) ∧
      (∀ (D : Finset (Fin 6)) (v : Fin 6 → ℝ),
        metricOf (Matrix.diagonal fun a => if a ∈ D then (1 : ℝ) else 0) v =
          ((∑ a, (if a ∈ D then 0 else v a ^ 2) - ∑ a, (if a ∈ D then v a ^ 2 else 0) : ℝ) : ℂ)) ∧
      (∀ D : Finset (Fin 5), D.card % 2 = 0 → ∀ x : Fin 5 ⊕ Fin 10,
        (realGen D x)ᴴ * hermForm D + hermForm D * realGen D x = 0) ∧
      (∀ D : Finset (Fin 5), D.card % 2 = 0 →
        (hermForm D)ᴴ = hermForm D ∧ hermForm D * hermForm D = 1 ∧
        (D.card ≠ 0 → (hermForm D).trace = 0)) ∧
      (∀ D : Finset (Fin 5), D.card % 2 = 1 → ∀ (x : Fin 5 ⊕ Fin 10) (v : Four → ℂ),
        realGen D x *ᵥ Cop D v = Cop D (realGen D x *ᵥ v)) ∧
      (∀ (D : Finset (Fin 5)) (v : Four → ℂ), Cop D (Cop D v) = (countSign D.card : ℂ) • v) ∧
      countSign 1 = -1 ∧ countSign 3 = 1 ∧ countSign 5 = -1 ∧
      (∀ v : Fin 6 → ℝ, GroupsContinuumLaw.OnCone v → GroupsContinuumLaw.r2 v = 1 →
        ∀ i j, GroupsContinuumLaw.g6 (GroupsContinuumLaw.frame v i) (GroupsContinuumLaw.frame v j) =
          if i = j then (if i = 0 then 1 else -1) else 0) ∧
      (∀ D : Finset (Fin 5), LinearIndependent ℂ (realGen D)) ∧
      (∀ D : Finset (Fin 5), D.card % 2 = 0 → ∀ X : Matrix Four Four ℂ,
        (X.trace = 0 ∧ Xᴴ * hermForm D + hermForm D * X = 0) ↔
          X ∈ Submodule.span ℝ (Set.range (realGen D))) ∧
      (∀ D : Finset (Fin 5), D.card % 2 = 1 → ∀ X : Matrix Four Four ℂ,
        (X.trace = 0 ∧ X * (gammaD D * J) = (gammaD D * J) * X.map star) ↔
          X ∈ Submodule.span ℝ (Set.range (realGen D))) ∧
      (∀ ε : Fin 6 → ℝ, (∀ i, ε i = 1 ∨ ε i = -1) → ∀ X : Matrix (Fin 6) (Fin 6) ℝ, Xᵀ = -X →
        (GroupsContinuumLaw.realFormMap ε X)ᵀ * Matrix.diagonal ε +
          Matrix.diagonal ε * GroupsContinuumLaw.realFormMap ε X = 0) ∧
      (∀ ε : Fin 6 → ℝ, (∀ i, ε i = 1 ∨ ε i = -1) → ∀ Y : Matrix (Fin 6) (Fin 6) ℝ,
        Yᵀ * Matrix.diagonal ε + Matrix.diagonal ε * Y = 0 →
          (GroupsContinuumLaw.realFormMap ε Y)ᵀ = -GroupsContinuumLaw.realFormMap ε Y ∧
            GroupsContinuumLaw.realFormMap ε (GroupsContinuumLaw.realFormMap ε Y) = Y) ∧
      (∀ (p q : ℕ) (v w : EuclideanSpace ℝ (Fin p) × EuclideanSpace ℝ (Fin q)), v ≠ 0 →
        ‖v.1‖ = ‖v.2‖ → w ≠ 0 → ‖w.1‖ = ‖w.2‖ →
          ((∃ c : ℝ, c ≠ 0 ∧ w = c • v) ↔
            (GroupsContinuumLaw.nrmPQ w = GroupsContinuumLaw.nrmPQ v ∨ GroupsContinuumLaw.nrmPQ w = -GroupsContinuumLaw.nrmPQ v))) ∧
      (∀ (p q : ℕ) (v : EuclideanSpace ℝ (Fin p) × EuclideanSpace ℝ (Fin q)), v ≠ 0 →
        ‖v.1‖ = ‖v.2‖ → 0 < ‖v.1‖ ∧ ‖(GroupsContinuumLaw.nrmPQ v).1‖ = 1 ∧ ‖(GroupsContinuumLaw.nrmPQ v).2‖ = 1)
    ) ∧
    (
      (∀ S : Finset (Fin 6), realFormAlg (projOf S) =
        (Submodule.span ℝ (Set.range (realGen6 S)) : Set (Matrix Four Four ℂ))) ∧
      (∀ S : Finset (Fin 6), LinearIndependent ℂ (realGen6 S) ∧
        finrank ℝ (Submodule.span ℝ (Set.range (realGen6 S))) = 15) ∧
      (∀ S : Finset (Fin 6), realFormAlg (projOf Sᶜ) = realFormAlg (projOf S)) ∧
      (∀ D : Finset (Fin 5), D.card % 2 = 0 → ∀ X : Matrix Four Four ℂ,
        X ∈ realFormAlg (projOf (linesDiv D)) ↔
          X.trace = 0 ∧ Xᴴ * hermForm D + hermForm D * X = 0) ∧
      (∀ D : Finset (Fin 5), D.card % 2 = 1 → ∀ X : Matrix Four Four ℂ,
        X ∈ realFormAlg (projOf (linesDiv D)) ↔
          X.trace = 0 ∧ X * (gammaD D * J) = (gammaD D * J) * X.map star) ∧
      (∀ P : Matrix (Fin 6) (Fin 6) ℝ, P * P = P → ∀ X : Matrix (Fin 6) (Fin 6) ℝ,
        X = (1 / 2 : ℝ) • (X + signOf P * X * signOf P) + (1 / 2 : ℝ) • (X - signOf P * X * signOf P) ∧
        KeptBy P ((1 / 2 : ℝ) • (X + signOf P * X * signOf P)) ∧
        MovedBy P ((1 / 2 : ℝ) • (X - signOf P * X * signOf P)))
    ) ∧
    ((∀ D : Finset (Fin 5), D.card % 2 = 0 →
        realForm (projOf (linesDiv D)) ≤ formGroup (hermForm D)) ∧
      (∀ D : Finset (Fin 5), D.card % 2 = 1 →
        realForm (projOf (linesDiv D)) ≤ antiGroup (gammaD D * J))) ∧
    (∀ P : Matrix (Fin 6) (Fin 6) ℝ, Pᵀ = P → P * P = P →
      ∃ (R : Matrix (Fin 6) (Fin 6) ℝ) (S : Finset (Fin 6)), Rᵀ * R = 1 ∧ R.det = 1 ∧
        P = R * projOf S * Rᵀ) ∧
    (∀ P : Matrix (Fin 6) (Fin 6) ℝ, Pᵀ = P → P * P = P →
      ∃ (S : Finset (Fin 6)) (U : GroupsContinuumLaw.SU4), ∀ X : Matrix Four Four ℂ,
        X ∈ realFormAlg P ↔
          (U : Matrix Four Four ℂ)⁻¹ * X * (U : Matrix Four Four ℂ) ∈
            (Submodule.span ℝ (Set.range (realGen6 S)) : Set (Matrix Four Four ℂ))) ∧
    (∀ P R X : Matrix (Fin 6) (Fin 6) ℝ, Rᵀ * R = 1 →
      (KeptBy (R * P * Rᵀ) (R * X * Rᵀ) ↔ KeptBy P X) ∧
        (MovedBy (R * P * Rᵀ) (R * X * Rᵀ) ↔ MovedBy P X)) ∧
    (∀ U : (Matrix Four Four ℂ)ˣ, U ∈ realForm (projOf (linesDiv ∅)) ↔
      (U : Matrix Four Four ℂ).det = 1 ∧ (U : Matrix Four Four ℂ)ᴴ * U = 1) :=
  ⟨four_kinds_statement, realForm_statement, ⟨realForm_le_formGroup, realForm_le_antiGroup⟩,
    exists_rot_projOf, realFormAlg_every_division,
    fun P R X hR => ⟨keptBy_conj P R X hR, movedBy_conj P R X hR⟩, realForm_point_iff⟩

end Comparison.System

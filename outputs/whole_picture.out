| 1|5 direction h | 0.25j | (0.75-1.25j) | (0.75-0.25j) | (0.75+0.75j) | (1.0625+0j) | (0.0363+0.0622j) | (-0.076923+0j) | 0.333333j | (0.010204+0j) |
